{
  "name": "webhookadmin",
  "version": "0.5.0",
  "description": "Node.js / TypeScript SDK for Webhook Admin: send webhooks, manage endpoints and verify signatures.",
  "keywords": [
    "webhook",
    "webhooks",
    "standard-webhooks",
    "webhookadmin",
    "sdk"
  ],
  "license": "MIT",
  "author": "SHANNON LIMITED LIABILITY COMPANY",
  "homepage": "https://webhookadmin.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shannonllc/webhookadmin-node.git"
  },
  "bugs": {
    "url": "https://github.com/shannonllc/webhookadmin-node/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage && tsup && node scripts/pack-check.mjs",
    "prepublishOnly": "pnpm typecheck && vitest run --coverage && tsup && node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "miniflare": "5.20260925.0-alpha",
    "standardwebhooks": "^1.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
